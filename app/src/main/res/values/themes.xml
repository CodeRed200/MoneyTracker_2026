<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.MoneyTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.MoneyTracker" parent="Base.Theme.MoneyTracker" />

    <style name="SettingsSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_settings_card</item>
        <item name="android:padding">15dp</item>
    </style>

    <style name="SettingsPrimaryText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSecondaryText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="SettingsFieldLabel" parent="SettingsPrimaryText">
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/app_text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingsEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">49dp</item>
        <item name="android:background">@drawable/bg_settings_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textColorHint">@color/app_text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">49dp</item>
        <item name="android:background">@drawable/bg_settings_input</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>

    <style name="SettingsStaticField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_settings_input</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">13dp</item>
        <item name="android:textColor">@color/app_text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsIconTile">
        <item name="android:layout_width">39dp</item>
        <item name="android:layout_height">39dp</item>
        <item name="android:background">@color/brand_soft</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="SettingsActionText">
        <item name="android:background">@drawable/bg_settings_action</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsActionTextWarning" parent="SettingsActionText">
        <item name="android:background">@drawable/bg_settings_warning_action</item>
        <item name="android:textColor">@color/warning_color</item>
    </style>

    <style name="SettingsDangerAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_settings_danger_action</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/danger_color</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSecondaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:backgroundTint">@color/neutral_soft</item>
        <item name="android:textColor">@color/app_text_muted</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsLinkText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">43dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/app_text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/app_outline</item>
    </style>

    <style name="SettingsErrorMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_settings_danger_action</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/danger_color</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingsSuccessMessage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_settings_success_action</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/success_color</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
