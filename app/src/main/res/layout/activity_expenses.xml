<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".ExpensesActivity">

    <LinearLayout
        android:id="@+id/expensesToolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnExpensesBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Go back"
            android:gravity="center"
            android:text="‹"
            android:textColor="#202334"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Expenses"
                android:textColor="#202334"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track where your money goes"
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAddExpense"
            android:layout_width="105dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_login_logo"
            android:contentDescription="Add expense"
            android:gravity="center"
            android:text="＋ Add Expense"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/expensesScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/expensesToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Expense Overview"
                android:textColor="#202334"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Monitor your daily purchases and monthly spending habits."
                android:textColor="#858B9E"
                android:textSize="12sp" />

            <!-- MONTH SELECTOR -->
            <LinearLayout
                android:id="@+id/expenseMonthCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_login_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Month"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvExpenseMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="November 2026"
                        android:textColor="#202334"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnPreviousExpenseMonth"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:background="@drawable/bg_login_input"
                    android:contentDescription="Previous month"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#6558D3"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNextExpenseMonth"
                    android:layout_width="39dp"
                    android:layout_height="39dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_login_input"
                    android:contentDescription="Next month"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#6558D3"
                    android:textSize="25sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- MONTHLY SUMMARY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="11dp"
                android:text="Monthly Spending Summary"
                android:textColor="#202334"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/totalExpenseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.07"
                    android:text="TOTAL EXPENSES THIS MONTH"
                    android:textColor="#858B9E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalExpenseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="₱0.00"
                    android:textColor="#D85D68"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExpenseMonthlyComparison"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Your recorded spending for this month"
                    android:textColor="#858B9E"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#EFEDFF"
                        android:gravity="center"
                        android:text="▤"
                        android:textColor="#6558D3"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Transactions"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvExpenseCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textColor="#6558D3"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#FFF5E9"
                        android:gravity="center"
                        android:text="∑"
                        android:textColor="#D58A36"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Average Expense"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvAverageExpense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#D58A36"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#FFF0F0"
                        android:gravity="center"
                        android:text="↑"
                        android:textColor="#D85D68"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Largest Expense"
                        android:textColor="#858B9E"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvLargestExpense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#D85D68"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- QUICK CATEGORY ENTRY -->
            <LinearLayout
                android:id="@+id/quickExpenseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quick Add Expense"
                    android:textColor="#202334"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose a category to start recording your spending."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipExpenseFood"
                            android:layout_width="wrap_content"
                            android:layout_height="41dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_logo"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🍚 Food"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/chipExpenseTransport"
                            android:layout_width="wrap_content"
                            android:layout_height="41dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🚌 Fare"
                            android:textColor="#50556B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipExpenseGroceries"
                            android:layout_width="wrap_content"
                            android:layout_height="41dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🛒 Grocery"
                            android:textColor="#50556B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipExpenseLoad"
                            android:layout_width="wrap_content"
                            android:layout_height="41dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="📱 Load"
                            android:textColor="#50556B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipExpenseShopping"
                            android:layout_width="wrap_content"
                            android:layout_height="41dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🛍 Shop"
                            android:textColor="#50556B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/btnOpenExpenseForm"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/bg_login_logo"
                    android:gravity="center"
                    android:text="＋ Enter Expense Details"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- EXPENSE HISTORY FILTERS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="Expense History"
                android:textColor="#202334"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etExpenseSearch"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_card"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="10dp"
                android:hint="Search description, notes or amount"
                android:inputType="text"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:textColor="#202334"
                android:textColorHint="#A0A4B2"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="6dp"
                android:text="Filter by category"
                android:textColor="#50556B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spExpenseCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_input"
                android:contentDescription="Filter expense category"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="6dp"
                android:text="Filter by payday period"
                android:textColor="#50556B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spExpensePaydayPeriod"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_login_input"
                android:contentDescription="Filter payday period"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:id="@+id/tvExpenseFilterSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Showing all expenses for the selected month."
                android:textColor="#858B9E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnClearExpenseFilters"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_login_input"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="Clear Filters"
                android:textColor="#6558D3"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- CATEGORY BREAKDOWN -->
            <LinearLayout
                android:id="@+id/expenseCategoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Spending by Category"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="See which categories take the largest share of your budget."
                    android:textColor="#858B9E"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/expenseCategoryBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvExpenseCategoryEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="15dp"
                        android:text="No spending categories yet."
                        android:textColor="#858B9E"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- EXPENSE RECORDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Expense Records"
                        android:textColor="#202334"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExpenseRecordCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 records"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/expenseRecordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/expenseLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="#6558D3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Loading expense records..."
                        android:textColor="#858B9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/expenseEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="65dp"
                        android:background="#EFEDFF"
                        android:gravity="center"
                        android:text="▤"
                        android:textColor="#6558D3"
                        android:textSize="30sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:gravity="center"
                        android:text="No Expenses Yet"
                        android:textColor="#202334"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Your recorded expenses will appear here. Add your first expense to get started."
                        android:textColor="#858B9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/expenseListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExpenseError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFF0F0"
                android:padding="12dp"
                android:textColor="#D85D68"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Unable to load expenses. Please try again."
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
