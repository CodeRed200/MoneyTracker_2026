<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".Login">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Branding -->
            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_login_logo"
                android:gravity="center"
                android:text="₱"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="My Finance"
                android:textColor="#202334"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="Your money. Your goals. Your future."
                android:textColor="#858B9E"
                android:textSize="14sp" />

            <!-- Login Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_login_card"
                android:elevation="5dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome back!"
                    android:textColor="#202334"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="25dp"
                    android:text="Sign in to access your financial dashboard."
                    android:textColor="#858B9E"
                    android:textSize="13sp" />

                <!-- Username / Email -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Username or email"
                    android:textColor="#50556B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Enter username or email"
                    android:inputType="text"
                    android:autofillHints="username"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="#202334"
                    android:textColorHint="#A0A4B2"
                    android:textSize="14sp" />

                <!-- Password Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="Password"
                    android:textColor="#50556B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Password Input -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_login_input"
                        android:hint="Enter your password"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:paddingStart="15dp"
                        android:paddingEnd="65dp"
                        android:singleLine="true"
                        android:textColor="#202334"
                        android:textColorHint="#A0A4B2"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:gravity="center"
                        android:background="?attr/selectableItemBackground"
                        android:text="Show"
                        android:textColor="#6558D3"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </FrameLayout>

                <!-- Forgot Password -->
                <TextView
                    android:id="@+id/btnForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="13dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="5dp"
                    android:text="Forgot password?"
                    android:textColor="#6558D3"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Login Error -->
                <TextView
                    android:id="@+id/tvLoginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#FFFFF0F0"
                    android:padding="10dp"
                    android:textColor="#D85D68"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="Invalid email or password."
                    tools:visibility="visible" />

                <!-- Login Button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#6558D3"
                    android:text="Sign In"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/loginProgress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="#6558D3"
                    android:visibility="gone" />

                <!-- Registration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New here? "
                        android:textColor="#858B9E"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnCreateAccount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="5dp"
                        android:text="Create an account"
                        android:textColor="#6558D3"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <!-- Security Note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Your financial records are private and secure."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PERSONAL FINANCE TRACKER · PHP"
                android:textColor="#A0A4B2"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
