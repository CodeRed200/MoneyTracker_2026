<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".MainActivity">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="17dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:background="@drawable/bg_login_logo"
            android:gravity="center"
            android:text="₱"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Finance"
                android:textColor="#202334"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal Money Manager"
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnNotifications"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:gravity="center"
            android:text="♧"
            android:textColor="#50556B"
            android:textSize="23sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvUserAvatar"
            android:layout_width="39dp"
            android:layout_height="39dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_login_logo"
            android:contentDescription="Open user settings"
            android:gravity="center"
            android:text="U"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- DASHBOARD CONTENT -->
    <ScrollView
        android:id="@+id/dashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good day!"
                android:textColor="#202334"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDashboardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Here's your financial overview."
                android:textColor="#858B9E"
                android:textSize="12sp" />

            <!-- MONTH LABEL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Financial Overview"
                    android:textColor="#202334"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="37dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="November 2026"
                    android:textColor="#6558D3"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- AVAILABLE BALANCE -->
            <LinearLayout
                android:id="@+id/balanceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_logo"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="AVAILABLE BALANCE"
                    android:textColor="#DDD9FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAvailableBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:letterSpacing="-0.03"
                    android:text="₱0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBalanceDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Your recorded cash balance"
                    android:textColor="#DDD9FF"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="17dp"
                    android:layout_marginBottom="13dp"
                    android:background="#55FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Income this month"
                            android:textColor="#DDD9FF"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvIncomeAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="35dp"
                        android:background="#55FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expenses this month"
                            android:textColor="#DDD9FF"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvExpenseAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- FINANCIAL STATISTICS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:layout_marginBottom="11dp"
                android:text="Your Money at a Glance"
                android:textColor="#202334"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:background="#E7F7F0"
                        android:gravity="center"
                        android:text="↗"
                        android:textColor="#149B71"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Total Income"
                        android:textColor="#858B9E"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalIncome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#149B71"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:background="#FFF0F0"
                        android:gravity="center"
                        android:text="↙"
                        android:textColor="#D85D68"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Total Expenses"
                        android:textColor="#858B9E"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalExpenses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#D85D68"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:background="#EAF3FF"
                        android:gravity="center"
                        android:text="◈"
                        android:textColor="#4285D4"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Total Savings"
                        android:textColor="#858B9E"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTotalSavings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#4285D4"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:background="#FFF5E9"
                        android:gravity="center"
                        android:text="▣"
                        android:textColor="#D58A36"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Outstanding Debt"
                        android:textColor="#858B9E"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvOutstandingDebt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#D58A36"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- QUICK DAILY SPENDING -->
            <LinearLayout
                android:id="@+id/quickExpenseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quick Daily Spending"
                    android:textColor="#202334"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Record your spending without opening another screen."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipFood"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🍚 Food"
                            android:textColor="#50556B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipTransport"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🚌 Fare"
                            android:textColor="#50556B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipGroceries"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🛒 Grocery"
                            android:textColor="#50556B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipLoad"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="📱 Load"
                            android:textColor="#50556B"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chipShopping"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:background="@drawable/bg_login_input"
                            android:gravity="center"
                            android:paddingStart="13dp"
                            android:paddingEnd="13dp"
                            android:text="🛍 Shop"
                            android:textColor="#50556B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etQuickExpenseDescription"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="What did you spend on?"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionNext"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="#202334"
                    android:textColorHint="#A0A4B2"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etQuickExpenseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Amount (₱)"
                    android:inputType="numberDecimal|numberSigned"
                    android:imeOptions="actionDone"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="#202334"
                    android:textColorHint="#A0A4B2"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnSaveQuickExpense"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:layout_marginTop="13dp"
                    android:backgroundTint="#6558D3"
                    android:text="＋ Save Expense"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- NEXT PAYDAY -->
            <LinearLayout
                android:id="@+id/nextPaydayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next Payday"
                        android:textColor="#202334"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPaydayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#EFEDFF"
                        android:padding="7dp"
                        android:text="Upcoming"
                        android:textColor="#6558D3"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNextPayday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="15th Salary"
                    android:textColor="#6558D3"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPaydayDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Expected payment date"
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="13dp"
                    android:background="#EAECF2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Expected Net Salary"
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPaydayAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Not set"
                    android:textColor="#149B71"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RECENT TRANSACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Transactions"
                    android:textColor="#202334"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSeeAllTransactions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="7dp"
                    android:text="See all →"
                    android:textColor="#6558D3"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transactionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:id="@+id/tvEmptyTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="5dp"
                    android:padding="25dp"
                    android:text="No transactions yet.\nYour financial activity will appear here."
                    android:textColor="#858B9E"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="15dp" />
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAVIGATION -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#6558D3"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#6558D3"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▦"
                android:textColor="#858B9E"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:background="@drawable/bg_login_logo"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="29sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Add"
                android:textColor="#6558D3"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navActivity"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⇄"
                android:textColor="#858B9E"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activity"
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="•••"
                android:textColor="#858B9E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More"
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
