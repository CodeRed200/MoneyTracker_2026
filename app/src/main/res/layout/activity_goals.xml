<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".GoalsActivity">

    <LinearLayout
        android:id="@+id/goalsToolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnGoalsBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Go back"
            android:gravity="center"
            android:text="‹"
            android:textColor="#202334"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Savings Goals"
                android:textColor="#202334"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan today. Achieve tomorrow."
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAddGoal"
            android:layout_width="100dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_login_logo"
            android:gravity="center"
            android:text="＋ New Goal"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/goalsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/goalsToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Financial Goals"
                android:textColor="#202334"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Set targets, save consistently and celebrate your progress."
                android:textColor="#858B9E"
                android:textSize="12sp" />

            <!-- Overall savings progress -->
            <LinearLayout
                android:id="@+id/goalOverviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_login_logo"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="TOTAL SAVINGS PROGRESS"
                    android:textColor="#DDD9FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalsTotalSaved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="₱0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalsTotalTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="of ₱0.00 total goal targets"
                    android:textColor="#DDD9FF"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/progressTotalGoals"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="9dp"
                    android:layout_marginTop="17dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#66FFFFFF"
                    android:progressTint="#FFFFFF" />

                <TextView
                    android:id="@+id/tvGoalsOverallPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="0% overall completion"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Goal statistics -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="11dp"
                android:text="Goal Statistics"
                android:textColor="#202334"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:background="#EFEDFF"
                        android:gravity="center"
                        android:text="◎"
                        android:textColor="#6558D3"
                        android:textSize="19sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Active Goals"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvActiveGoalsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textColor="#6558D3"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:background="#E7F7F0"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#149B71"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Completed"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvCompletedGoalsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="0"
                        android:textColor="#149B71"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="108dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="31dp"
                        android:layout_height="31dp"
                        android:background="#FFF5E9"
                        android:gravity="center"
                        android:text="₱"
                        android:textColor="#D58A36"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Still Needed"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvGoalsRemainingAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#D58A36"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Goal list heading, filter and search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My Savings Goals"
                    android:textColor="#202334"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnGoalFilter"
                    android:layout_width="96dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center"
                    android:text="All Goals ▾"
                    android:textColor="#6558D3"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etGoalSearch"
                android:layout_width="match_parent"
                android:layout_height="47dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_login_card"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="9dp"
                android:hint="Search your savings goals"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="#202334"
                android:textColorHint="#A0A4B2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvGoalsSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Checking local and cloud data..."
                android:textColor="#858B9E"
                android:textSize="10sp" />

            <!-- Add / edit goal form -->
            <LinearLayout
                android:id="@+id/goalFormCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGoalFormTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Create Savings Goal"
                        android:textColor="#202334"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCloseGoalForm"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_login_input"
                        android:contentDescription="Close form"
                        android:gravity="center"
                        android:text="×"
                        android:textColor="#858B9E"
                        android:textSize="23sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etGoalId"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="7dp"
                    android:text="Goal Name *"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGoalName"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Emergency fund, travel, new phone..."
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="#202334"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="7dp"
                    android:text="Target Amount (₱) *"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGoalTarget"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="#202334"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="7dp"
                    android:text="Target Date (Optional)"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalTargetDate"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:clickable="true"
                    android:contentDescription="Select target date"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Select target date"
                    android:textColor="#858B9E"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="7dp"
                    android:text="Goal Icon / Emoji"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGoalIcon"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="◎"
                    android:maxLength="12"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:text="◎"
                    android:textColor="#202334"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="7dp"
                    android:text="Description (Optional)"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGoalDescription"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="top"
                    android:hint="Why are you saving for this goal?"
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="12dp"
                    android:textColor="#202334"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvGoalFormError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="#FFFFF0F0"
                    android:padding="10dp"
                    android:textColor="#D85D68"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Please enter a valid goal name and target amount."
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btnSaveGoal"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:layout_marginTop="15dp"
                    android:backgroundTint="#6558D3"
                    android:text="Save Goal"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Goals list -->
            <LinearLayout
                android:id="@+id/goalsListCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/goalsLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="#6558D3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Loading your savings goals..."
                        android:textColor="#858B9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/goalsEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="#EFEDFF"
                        android:gravity="center"
                        android:text="◎"
                        android:textColor="#6558D3"
                        android:textSize="37sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:gravity="center"
                        android:text="No Savings Goals Yet"
                        android:textColor="#202334"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Create your first financial goal and start building your future."
                        android:textColor="#858B9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/goalCardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Record goal movement -->
            <LinearLayout
                android:id="@+id/goalMovementCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Record a Goal Movement"
                    android:textColor="#202334"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Add money to a goal or record a withdrawal."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="6dp"
                    android:text="Select Savings Goal *"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spGoalMovementGoal"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="Movement Type"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spGoalMovementType"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="Amount (₱) *"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGoalMovementAmount"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="0.00"
                    android:inputType="numberDecimal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="#202334"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="Movement Date"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGoalMovementDate"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:background="@drawable/bg_login_input"
                    android:clickable="true"
                    android:contentDescription="Select movement date"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:text="Select date"
                    android:textColor="#858B9E"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="6dp"
                    android:text="Notes (Optional)"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etGoalMovementNotes"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="top"
                    android:hint="Add a note about this movement..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:padding="12dp"
                    android:textColor="#202334"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#EFEDFF"
                    android:lineSpacingExtra="3dp"
                    android:padding="11dp"
                    android:text="Contributions reduce available cash. Withdrawals return money to cash. Neither movement is counted as an expense."
                    android:textColor="#6558D3"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvGoalMovementError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="#FFFFF0F0"
                    android:padding="10dp"
                    android:textColor="#D85D68"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Please complete all required fields."
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btnRecordGoalMovement"
                    android:layout_width="match_parent"
                    android:layout_height="51dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#6558D3"
                    android:text="Record Movement"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Movement history -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="Contribution &amp; Withdrawal History"
                android:textColor="#202334"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/goalHistoryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="12dp">

                <ProgressBar
                    android:id="@+id/goalHistoryLoading"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#6558D3"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvGoalHistoryEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="22dp"
                    android:text="No goal movements recorded yet."
                    android:textColor="#858B9E"
                    android:textSize="11sp"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/goalHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGoalsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFF0F0"
                android:padding="12dp"
                android:textColor="#D85D68"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Unable to load savings goals. Please try again."
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/goalsProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:indeterminateTint="#6558D3"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
