<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".AnalyticsActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/analyticsToolbar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btnAnalyticsBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Go back"
            android:gravity="center"
            android:text="‹"
            android:textColor="#202334"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Analytics"
                android:textColor="#202334"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your financial performance"
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExportAnalytics"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_login_logo"
            android:contentDescription="Export analytics as CSV"
            android:gravity="center"
            android:text="↓ Export"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main scroll content -->
    <ScrollView
        android:id="@+id/analyticsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/analyticsToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Intro and sync status -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Financial Performance"
                android:textColor="#202334"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Understand your financial habits and track your progress."
                android:textColor="#858B9E"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAnalyticsSyncStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E7F7F0"
                android:padding="10dp"
                android:text="Your analytics are saved on this device and sync with Firebase."
                android:textColor="#149B71"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAnalyticsLastUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="No successful cloud sync yet"
                android:textColor="#858B9E"
                android:textSize="10sp" />

            <!-- Filters -->
            <LinearLayout
                android:id="@+id/analyticsFilterCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Analytics Filters"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose a period and transaction category."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:text="From date"
                            android:textColor="#50556B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnalyticsFromDate"
                            android:layout_width="match_parent"
                            android:layout_height="47dp"
                            android:background="@drawable/bg_login_input"
                            android:clickable="true"
                            android:contentDescription="Select starting date"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="11dp"
                            android:paddingEnd="8dp"
                            android:text="Start date"
                            android:textColor="#50556B"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="7dp"
                            android:text="To date"
                            android:textColor="#50556B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAnalyticsToDate"
                            android:layout_width="match_parent"
                            android:layout_height="47dp"
                            android:background="@drawable/bg_login_input"
                            android:clickable="true"
                            android:contentDescription="Select ending date"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:paddingStart="11dp"
                            android:paddingEnd="8dp"
                            android:text="End date"
                            android:textColor="#50556B"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="7dp"
                    android:text="Category"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spAnalyticsCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_login_input"
                    android:contentDescription="Filter by expense category"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:spinnerMode="dropdown" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="7dp"
                    android:text="Transaction type"
                    android:textColor="#50556B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spAnalyticsType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_login_input"
                    android:contentDescription="Filter by transaction type"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:spinnerMode="dropdown" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnFilterThisMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#6558D3"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="This Month"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnFilterLastMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#EFEDFF"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="Last Month"
                            android:textAllCaps="false"
                            android:textColor="#6558D3"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnFilterThreeMonths"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="#EFEDFF"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="3 Months"
                            android:textAllCaps="false"
                            android:textColor="#6558D3"
                            android:textSize="10sp" />

                        <Button
                            android:id="@+id/btnFilterThisYear"
                            android:layout_width="wrap_content"
                            android:layout_height="39dp"
                            android:backgroundTint="#EFEDFF"
                            android:minWidth="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="This Year"
                            android:textAllCaps="false"
                            android:textColor="#6558D3"
                            android:textSize="10sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btnApplyAnalyticsFilters"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="#6558D3"
                    android:text="Apply Filters"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAnalyticsFilterStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Showing all recorded financial activity."
                    android:textColor="#858B9E"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Financial summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:layout_marginBottom="12dp"
                android:text="Financial Summary"
                android:textColor="#202334"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="119dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↗ Income"
                        android:textColor="#149B71"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalyticsTotalIncome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="₱0.00"
                        android:textColor="#149B71"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvIncomeComparison"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Compared with previous period"
                        android:textColor="#858B9E"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="119dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↘ Expenses"
                        android:textColor="#D85D68"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalyticsTotalExpenses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="₱0.00"
                        android:textColor="#D85D68"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvExpenseComparison"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Compared with previous period"
                        android:textColor="#858B9E"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="119dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Net Cash Flow"
                        android:textColor="#858B9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalyticsNetCashFlow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="₱0.00"
                        android:textColor="#6558D3"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCashFlowDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Income less expenses"
                        android:textColor="#858B9E"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="119dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Savings Rate"
                        android:textColor="#858B9E"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAnalyticsSavingsRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:text="0%"
                        android:textColor="#4285D4"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSavingsRateDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Based on recorded income"
                        android:textColor="#858B9E"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Income vs expenses chart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Income vs Expenses"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Compare your monthly earnings and spending."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="center_vertical"
                        android:background="#149B71" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="15dp"
                        android:text="Income"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="center_vertical"
                        android:background="#D85D68" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Expenses"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/chartIncomeExpense"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="12dp"
                    android:background="#FAFAFD">

                    <TextView
                        android:id="@+id/tvIncomeExpenseChartPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="Income and expense chart will appear when records are loaded."
                        android:textColor="#A0A4B2"
                        android:textSize="11sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Spending by category -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Spending by Category"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Discover where most of your money goes."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <FrameLayout
                    android:id="@+id/chartCategorySpending"
                    android:layout_width="match_parent"
                    android:layout_height="185dp"
                    android:layout_marginTop="12dp"
                    android:background="#FAFAFD">

                    <TextView
                        android:id="@+id/tvCategoryChartPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Category breakdown will appear here."
                        android:textColor="#A0A4B2"
                        android:textSize="11sp" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/categoryBreakdownContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Payday cash flow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Payday-to-Payday Cash Flow"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Track your money between salary periods."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <FrameLayout
                    android:id="@+id/chartPaydayCashFlow"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp"
                    android:background="#FAFAFD">

                    <TextView
                        android:id="@+id/tvPaydayChartPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Payday cash flow chart will appear here."
                        android:textColor="#A0A4B2"
                        android:textSize="11sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Savings growth -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Savings Growth"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Monitor how your savings build over time."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvAnalyticsTotalSavings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="₱0.00"
                    android:textColor="#4285D4"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Net savings movement in selected period"
                    android:textColor="#858B9E"
                    android:textSize="10sp" />

                <FrameLayout
                    android:id="@+id/chartSavingsGrowth"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp"
                    android:background="#FAFAFD">

                    <TextView
                        android:id="@+id/tvSavingsChartPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="Savings growth chart will appear here."
                        android:textColor="#A0A4B2"
                        android:textSize="11sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Debt repayment progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Debt Repayment Progress"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Track how much of your recorded loan principal has been paid."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Repaid"
                            android:textColor="#858B9E"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvDebtRepaid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#149B71"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Remaining Debt"
                            android:textColor="#858B9E"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvDebtRemaining"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#D85D68"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressDebtRepayment"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="17dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#EAECF2"
                    android:progressTint="#149B71" />

                <TextView
                    android:id="@+id/tvDebtProgressPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="0% of recorded debt repaid"
                    android:textColor="#858B9E"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Financial goals -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Financial Goal Completion"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="See how close you are to reaching your savings targets."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed Goals"
                            android:textColor="#858B9E"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvGoalsCompleted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="0"
                            android:textColor="#149B71"
                            android:textSize="21sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Goals"
                            android:textColor="#858B9E"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvGoalsActive"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="0"
                            android:textColor="#6558D3"
                            android:textSize="21sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressGoals"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="16dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#EAECF2"
                    android:progressTint="#6558D3" />

                <TextView
                    android:id="@+id/tvGoalProgressPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="0% overall goal completion"
                    android:textColor="#858B9E"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Loading and error -->
            <LinearLayout
                android:id="@+id/analyticsLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:indeterminateTint="#6558D3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Refreshing financial analytics..."
                    android:textColor="#858B9E"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAnalyticsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFF0F0"
                android:padding="12dp"
                android:textColor="#D85D68"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Some analytics collections could not be refreshed."
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
