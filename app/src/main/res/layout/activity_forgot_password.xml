<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".ForgotPasswordActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="35dp"
            android:paddingBottom="35dp">

            <!-- APP BRANDING -->

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_login_logo"
                android:gravity="center"
                android:text="₱"
                android:textColor="#FFFFFF"
                android:textSize="33sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="My Finance"
                android:textColor="#202334"
                android:textSize="23sp"
                android:textStyle="bold" />

            <!-- RESET ICON -->

            <TextView
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_marginTop="30dp"
                android:background="#EFEDFF"
                android:gravity="center"
                android:text="↻"
                android:textColor="#6558D3"
                android:textSize="48sp"
                android:textStyle="bold" />

            <!-- PAGE TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center"
                android:text="Forgot Password?"
                android:textColor="#202334"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Don't worry! It happens. Enter your registered email address and we'll send you a link to reset your password."
                android:textColor="#858B9E"
                android:textSize="13sp" />

            <!-- RESET PASSWORD CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_login_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recover your account"
                    android:textColor="#202334"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:text="We'll help you get back into your account."
                    android:textColor="#858B9E"
                    android:textSize="12sp" />

                <!-- EMAIL LABEL -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Registered email address"
                    android:textColor="#50556B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- EMAIL INPUT -->

                <EditText
                    android:id="@+id/etForgotEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="Enter your email address"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:singleLine="true"
                    android:textColor="#202334"
                    android:textColorHint="#A0A4B2"
                    android:textSize="14sp" />

                <!-- RESET INSTRUCTIONS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:background="#EFEDFF"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="wrap_content"
                        android:text="ⓘ"
                        android:textColor="#6558D3"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="You'll receive a password-reset link by email. Open the link to create a new password."
                        android:textColor="#6558D3"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

                <!-- ERROR MESSAGE -->

                <TextView
                    android:id="@+id/tvForgotError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="#FFFFF0F0"
                    android:padding="11dp"
                    android:textColor="#D85D68"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Please enter a valid email address."
                    tools:visibility="visible" />

                <!-- SUCCESS MESSAGE -->

                <TextView
                    android:id="@+id/tvForgotSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="#FFE7F7F0"
                    android:padding="12dp"
                    android:textColor="#149B71"
                    android:textSize="11sp"
                    android:lineSpacingExtra="3dp"
                    android:visibility="gone"
                    tools:text="Reset email sent. Please check your inbox."
                    tools:visibility="visible" />

                <!-- SEND RESET EMAIL -->

                <Button
                    android:id="@+id/btnSendResetEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#6558D3"
                    android:text="Send Reset Link"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- LOADING -->

                <ProgressBar
                    android:id="@+id/forgotPasswordProgress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="13dp"
                    android:indeterminateTint="#6558D3"
                    android:visibility="gone" />

                <!-- BACK TO LOGIN -->

                <TextView
                    android:id="@+id/btnBackToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="← Back to Sign In"
                    android:textColor="#6558D3"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- SECURITY FOOTER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="Your financial information remains protected."
                    android:textColor="#858B9E"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="PERSONAL FINANCE TRACKER · PHP"
                android:textColor="#A0A4B2"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
