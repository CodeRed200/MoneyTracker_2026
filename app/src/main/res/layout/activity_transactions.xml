<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".TransactionsActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/transactionsToolbar"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="#FFFFFF"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnTransactionsBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="Go back"
            android:gravity="center"
            android:text="‹"
            android:textColor="#202334"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transactions"
                android:textColor="#202334"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your complete financial activity"
                android:textColor="#858B9E"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnExportTransactions"
            android:layout_width="82dp"
            android:layout_height="39dp"
            android:background="@drawable/bg_login_input"
            android:gravity="center"
            android:text="Export"
            android:textColor="#6558D3"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable transaction content -->
    <ScrollView
        android:id="@+id/transactionsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/transactionsToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp">

            <!-- Page heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Financial Activity"
                android:textColor="#202334"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="3dp"
                android:text="View and search your salary, expenses, savings movements and payments."
                android:textColor="#858B9E"
                android:textSize="12sp" />

            <!-- Month selector -->
            <LinearLayout
                android:id="@+id/transactionsMonthCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_login_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Period"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTransactionsMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="November 2026"
                        android:textColor="#202334"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnPreviousTransactionMonth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_login_input"
                    android:contentDescription="Previous month"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#6558D3"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNextTransactionMonth"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_login_input"
                    android:contentDescription="Next month"
                    android:gravity="center"
                    android:text="›"
                    android:textColor="#6558D3"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cash flow overview -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp"
                android:text="Cash Flow Overview"
                android:textColor="#202334"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/transactionsOverviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_logo"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="NET CASH MOVEMENT"
                    android:textColor="#DDD9FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransactionsNetMovement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="₱0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="31sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransactionsNetDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Net money movement during the selected month"
                    android:textColor="#DDD9FF"
                    android:textSize="10sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="13dp"
                    android:background="#55FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Money In"
                            android:textColor="#DDD9FF"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvTransactionsMoneyIn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="38dp"
                        android:background="#55FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Money Out"
                            android:textColor="#DDD9FF"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvTransactionsMoneyOut"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="₱0.00"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Activity summary -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:layout_marginBottom="10dp"
                android:text="Activity Summary"
                android:textColor="#202334"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="103dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#E7F7F0"
                        android:gravity="center"
                        android:text="↑"
                        android:textColor="#149B71"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Income"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTransactionsIncome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#149B71"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="103dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#FFF1F1"
                        android:gravity="center"
                        android:text="↓"
                        android:textColor="#D85D68"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Expenses"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTransactionsExpenses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#D85D68"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="103dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#EFEDFF"
                        android:gravity="center"
                        android:text="◈"
                        android:textColor="#6558D3"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Savings Added"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTransactionsSavingsAdded"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#6558D3"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="103dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_login_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="#FFF5E9"
                        android:gravity="center"
                        android:text="₱"
                        android:textColor="#D58A36"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="Debt &amp; Bills Paid"
                        android:textColor="#858B9E"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvTransactionsPayments"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="₱0.00"
                        android:textColor="#D58A36"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Transaction breakdown -->
            <LinearLayout
                android:id="@+id/transactionsTypeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transaction Breakdown"
                    android:textColor="#202334"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <include layout="@layout/row_transaction_breakdown_salary" />
                <include layout="@layout/row_transaction_breakdown_expense" />
                <include layout="@layout/row_transaction_breakdown_contribution" />
                <include layout="@layout/row_transaction_breakdown_withdrawal" />
                <include layout="@layout/row_transaction_breakdown_bills" />
                <include layout="@layout/row_transaction_breakdown_loans" />
            </LinearLayout>

            <!-- Search and filters -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="All Transactions"
                android:textColor="#202334"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Search, filter and review your financial records."
                android:textColor="#858B9E"
                android:textSize="10sp" />

            <EditText
                android:id="@+id/etTransactionsSearch"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_login_card"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="9dp"
                android:hint="Search description, category or reference"
                android:inputType="text"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:singleLine="true"
                android:textColor="#202334"
                android:textColorHint="#A0A4B2"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="Transaction Type"
                android:textColor="#50556B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTransactionType"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:background="@drawable/bg_login_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="6dp"
                android:text="Category"
                android:textColor="#50556B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTransactionCategory"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:background="@drawable/bg_login_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginBottom="6dp"
                android:text="Payday Period"
                android:textColor="#50556B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spTransactionPaydayPeriod"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:background="@drawable/bg_login_card"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:spinnerMode="dropdown" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTransactionFilterSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Showing all transactions for the selected month."
                    android:textColor="#858B9E"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnClearTransactionFilters"
                    android:layout_width="92dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center"
                    android:text="Clear Filters"
                    android:textColor="#6558D3"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Transaction history -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Transaction History"
                    android:textColor="#202334"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransactionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#EFEDFF"
                    android:padding="7dp"
                    android:text="0 records"
                    android:textColor="#6558D3"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/transactionsRecordsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:id="@+id/transactionsLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:indeterminateTint="#6558D3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Loading transactions from Firebase..."
                        android:textColor="#858B9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/transactionsEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="25dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="#EFEDFF"
                        android:gravity="center"
                        android:text="₱"
                        android:textColor="#6558D3"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:gravity="center"
                        android:text="No Transactions Found"
                        android:textColor="#202334"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Your salary, expenses, savings and payments will appear here once recorded."
                        android:textColor="#858B9E"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/transactionsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btnLoadMoreTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center"
                    android:text="Load More Transactions"
                    android:textColor="#6558D3"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Selected transaction details -->
            <LinearLayout
                android:id="@+id/transactionDetailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="@drawable/bg_login_card"
                android:orientation="vertical"
                android:padding="15dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Transaction Details"
                        android:textColor="#202334"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCloseTransactionDetails"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_login_input"
                        android:contentDescription="Close transaction details"
                        android:gravity="center"
                        android:text="×"
                        android:textColor="#858B9E"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTransactionDetailType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="#EFEDFF"
                    android:padding="8dp"
                    android:text="Transaction Type"
                    android:textColor="#6558D3"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransactionDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Transaction description"
                    android:textColor="#202334"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransactionDetailAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="₱0.00"
                    android:textColor="#6558D3"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="15dp"
                    android:background="#EAECF2" />

                <include layout="@layout/row_transaction_detail_date" />
                <include layout="@layout/row_transaction_detail_category" />
                <include layout="@layout/row_transaction_detail_method" />
                <include layout="@layout/row_transaction_detail_payday" />
                <include layout="@layout/row_transaction_detail_reference" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Notes"
                    android:textColor="#858B9E"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransactionDetailNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:lineSpacingExtra="3dp"
                    android:text="No additional notes."
                    android:textColor="#50556B"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvTransactionDetailSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Source record"
                    android:textColor="#858B9E"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Accounting note -->
            <LinearLayout
                android:id="@+id/transactionsAccountingInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="#EFEDFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="How Transaction Totals Are Calculated"
                    android:textColor="#514B70"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="• Salary payments are recorded as income.&#10;&#10;• Everyday purchases are recorded as expenses.&#10;&#10;• Savings contributions and withdrawals are transfers between cash and savings.&#10;&#10;• Bill payments and loan repayments are shown separately from everyday expenses.&#10;&#10;• Unpaid bills and loan balances are not counted as completed cash transactions.&#10;&#10;• Carry-forward balances are opening balances, not new income."
                    android:textColor="#6558D3"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Status and errors -->
            <ProgressBar
                android:id="@+id/transactionsProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:indeterminateTint="#6558D3"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTransactionsError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#FFFFF0F0"
                android:padding="12dp"
                android:textColor="#D85D68"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Unable to load transactions. Please try again."
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvTransactionsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#149B71"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="Transactions loaded successfully."
                tools:visibility="visible" />

            <View
                android:layout_width="match_parent"
                android:layout_height="22dp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
