<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    tools:context=".EmailVerificationActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="35dp"
            android:paddingBottom="35dp">

            <!-- APP LOGO -->

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_login_logo"
                android:gravity="center"
                android:text="₱"
                android:textColor="#FFFFFF"
                android:textSize="33sp"
                android:textStyle="bold" />

            <!-- EMAIL ICON -->

            <TextView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="27dp"
                android:background="#EFEDFF"
                android:gravity="center"
                android:text="✉"
                android:textColor="#6558D3"
                android:textSize="43sp" />

            <!-- TITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center"
                android:text="Verify Your Email"
                android:textColor="#202334"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="One more step! Please verify your email address to activate your My Finance account."
                android:textColor="#858B9E"
                android:textSize="13sp" />

            <!-- VERIFICATION CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:background="@drawable/bg_login_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Check your inbox"
                    android:textColor="#202334"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="We've sent a verification link to:"
                    android:textColor="#858B9E"
                    android:textSize="12sp" />

                <!-- REGISTERED EMAIL -->

                <TextView
                    android:id="@+id/tvVerificationEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:background="#EFEDFF"
                    android:padding="13dp"
                    android:text="your-email@example.com"
                    android:textColor="#6558D3"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- INSTRUCTIONS -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="How to verify your account"
                    android:textColor="#202334"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Open your registered email inbox."
                        android:textColor="#62687A"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:text="2. Find the My Finance verification email."
                        android:textColor="#62687A"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:text="3. Open the email and tap the verification link."
                        android:textColor="#62687A"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:text="4. Return to this application and tap I've Verified."
                        android:textColor="#62687A"
                        android:textSize="12sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

                <!-- EMAIL STATUS -->

                <TextView
                    android:id="@+id/tvVerificationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:background="#FFF5E9"
                    android:padding="12dp"
                    android:text="Waiting for email verification..."
                    android:textColor="#B8752C"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />

                <!-- VERIFICATION PROGRESS -->

                <ProgressBar
                    android:id="@+id/verificationProgress"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="14dp"
                    android:indeterminateTint="#6558D3"
                    android:visibility="gone" />

                <!-- CHECK VERIFICATION BUTTON -->

                <Button
                    android:id="@+id/btnCheckVerification"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_marginTop="19dp"
                    android:backgroundTint="#6558D3"
                    android:text="I've Verified My Email"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- RESEND VERIFICATION -->

                <TextView
                    android:id="@+id/btnResendVerification"
                    android:layout_width="match_parent"
                    android:layout_height="49dp"
                    android:layout_marginTop="9dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Resend Verification Email"
                    android:textColor="#6558D3"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- CHANGE EMAIL -->

                <TextView
                    android:id="@+id/btnChangeVerificationEmail"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="Change Email Address"
                    android:textColor="#858B9E"
                    android:textSize="12sp" />

                <!-- ERROR MESSAGE -->

                <TextView
                    android:id="@+id/tvVerificationError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="#FFFFF0F0"
                    android:padding="11dp"
                    android:textColor="#D85D68"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Unable to verify your email. Please try again."
                    tools:visibility="visible" />

                <!-- SUCCESS MESSAGE -->

                <TextView
                    android:id="@+id/tvVerificationSuccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:background="#FFE7F7F0"
                    android:padding="11dp"
                    android:textColor="#149B71"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="Your email has been verified successfully!"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- SECURITY FOOTER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:gravity="center"
                android:text="🔒 Your financial records are protected."
                android:textColor="#858B9E"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PERSONAL FINANCE TRACKER · PHP"
                android:textColor="#A0A4B2"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
